<odoo>

    <data>
        <record id="res_config_settings_nimi_timbre_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.nimi.timbre.account.tax</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="50"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='has_accounting_entries']" position="after">
                    <h2 attrs="{'invisible': [('has_chart_of_accounts','==',False)]}">Timbre</h2>
                    <div class="row mt16 o_settings_container"
                         attrs="{'invisible': [('has_chart_of_accounts','==',False)]}">
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Compte comptable</span>
                                <div class="text-muted">Définissez les comptes comptable du Timbre pour achat et vente                                 </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="sales_timbre_account_id"
                                               class="col-md-3 o_light_label"/>
                                        <field name="sales_timbre_account_id" />
                                    </div>
                                    <div class="row mt16">
                                        <label for="purchase_timbre_account_id"
                                               class="col-md-3 o_light_label"/>
                                        <field name="purchase_timbre_account_id" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Configuration</span>
                                <div class="text-muted">Définissez la configuration à appliquer pour le calcul du droit de timbre, en précisant l'année de la loi de finances et la méthode de calcul.</div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="fiscal_year"
                                               class="col-md-3 o_light_label"/>
                                        <field name="fiscal_year" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>


    </data>

</odoo>