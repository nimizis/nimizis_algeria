<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_document_timbrenimi"
              inherit_id="sale.report_saleorder_document">

            <!--complicated expr to be compatible with other modules-->
            <xpath expr="//div[@name='so_total_summary']/div/div/table" position="inside">
                <tr t-if="doc.if_timbre!=False" >
                    <td>Timbre fiscal</td>
                    <td class="text-end">
                        <span t-field="doc.amount_timbre" widget="monetary"/>
                    </td>
                </tr>
                <tr t-if="doc.if_timbre!=False">
                    <td>Net à payer</td>
                    <td class="text-end o_price_total">
                        <span t-field="doc.amount_total"  widget="monetary" />
                    </td>
                </tr>
            </xpath>

    </template>
</odoo>
